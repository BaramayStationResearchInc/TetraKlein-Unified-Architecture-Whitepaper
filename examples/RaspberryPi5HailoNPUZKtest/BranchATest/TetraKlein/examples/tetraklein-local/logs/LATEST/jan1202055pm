class TKStarkTraceBuilder:
    def __init__(self, modulus):
        self.p = modulus

    def build(self, witness: TKZKWitnessRecorder):
        witness.check_air()
        cols = witness.export_trace_columns()
        n = len(cols["t"])

        trace = []
        for i in range(n):
            trace.append([
                cols["t"][i] % self.p,
                cols["x1"][i] % self.p,
                cols["x2"][i] % self.p,
                cols["y"][i] % self.p,
                cols["h"][i] % self.p,
            ])
        return trace

