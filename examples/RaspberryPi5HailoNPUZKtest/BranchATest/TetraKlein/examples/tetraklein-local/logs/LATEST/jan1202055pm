class TKEpochFolder:
    def __init__(self, modulus: int, alpha: int = 1315423911):
        self.p = modulus
        self.alpha = alpha
        self.acc = 0
        self.steps = 0

    def absorb(self, h: int):
        self.acc = (self.alpha * self.acc + h) % self.p
        self.steps += 1

    def root(self) -> int:
        return self.acc


