# 5. Trace Folding
# ---------------------------------------------------------------------

def test_trace_folding(trace):
    banner("5. Trace Folding")

    before = trace.shape[0]
    folded = trace[::2, :]
    after = folded.shape[0]

    print(f"Rows before: {before:,}")
    print(f"Rows after : {after:,}")

    if after != before // 2:
        fail("Folding incorrect")

    ok("Trace folding correct")

